{
  "name": "N8N-X-MONITOR-012 — Veille marque X/Twitter — AUDITÉ V2",
  "nodes": [
    {
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "name": "Twitter Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        300
      ],
      "parameters": {
        "url": "https://api.twitter.com/2/tweets/search/recent",
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $env.BRAND_NAME || 'MyBrand' }} -is:retweet"
            },
            {
              "name": "max_results",
              "value": "100"
            },
            {
              "name": "tweet.fields",
              "value": "author_id,created_at,public_metrics"
            },
            {
              "name": "expansions",
              "value": "author_id"
            },
            {
              "name": "user.fields",
              "value": "username,name"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.TWITTER_BEARER_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "name": "Has Results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-results",
              "leftValue": "={{ $json.data && $json.data.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Loop Over Tweets",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        800,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "name": "Important?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "likes-threshold",
              "leftValue": "={{ $json.likes }}",
              "rightValue": 5,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "neg-disappointed",
              "leftValue": "={{ $json.text }}",
              "rightValue": "disappointed",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "neg-angry",
              "leftValue": "={{ $json.text }}",
              "rightValue": "angry",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "neg-bad",
              "leftValue": "={{ $json.text }}",
              "rightValue": "bad",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "neg-hate",
              "leftValue": "={{ $json.text }}",
              "rightValue": "hate",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "neg-problem",
              "leftValue": "={{ $json.text }}",
              "rightValue": "problem",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "name": "Find Tweet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1400,
        300
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "tweet_id",
              "lookupValue": "={{ $json.tweet_id }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "googleSheetsOAuth2Api",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "Already Recorded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1600,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "already-exists",
              "leftValue": "={{ $json.tweet_id !== undefined && $json.tweet_id !== '' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Add Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1800,
        300
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "tweet_id": "={{ $json.tweet_id }}",
            "author_name": "={{ $json.author_name }}",
            "text": "={{ $json.text }}",
            "created_at": "={{ $json.created_at }}",
            "likes": "={{ $json.likes }}",
            "link": "={{ $json.link }}",
            "flags": "={{ $json.flags }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "googleSheetsOAuth2Api",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "Send Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        2000,
        300
      ],
      "parameters": {
        "sendTo": "={{ $env.ALERT_EMAIL }}",
        "subject": "=Alerte : mention de {{ $env.BRAND_NAME }} sur Twitter",
        "message": "=Mention détectée pour {{ $env.BRAND_NAME }}\n\nAuteur : {{ $json.author_name }} ({{ $json.author_id }})\nDate : {{ $json.created_at }}\nLikes : {{ $json.likes }}\nTexte : {{ $json.text }}\nLien : {{ $json.link }}",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "gmailOAuth2",
          "name": "Gmail account"
        }
      }
    },
    {
      "name": "Setup - notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        200,
        100
      ],
      "parameters": {
        "content": "## Audit V2\nNécessite un accès X API v2 permettant tweets/search/recent (souvent offre payante selon le compte). Variables : TWITTER_BEARER_TOKEN, BRAND_NAME, GOOGLE_SHEET_ID, ALERT_EMAIL.\nV2 éclate correctement data[] tweet par tweet et associe includes.users avant déduplication.",
        "height": 320,
        "width": 420,
        "color": 7
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$input.first().json||{}; if(!Array.isArray(p.data)) throw new Error('Réponse X/Twitter invalide ou accès API refusé.'); const users=new Map((p.includes?.users||[]).map(u=>[String(u.id),u])); return p.data.map(t=>{const u=users.get(String(t.author_id))||{}; return {json:{tweet_id:String(t.id||''),text:String(t.text||''),created_at:String(t.created_at||''),author_id:String(t.author_id||''),author_name:String(u.username||u.name||''),likes:Number(t.public_metrics?.like_count||0),link:t.id?`https://x.com/i/web/status/${t.id}`:'',flags:'NONE'}};});"
      },
      "id": "20c95b47-cc8c-4225-8375-60b650a6961d",
      "name": "Déplier résultats X",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        550,
        200
      ]
    }
  ],
