{
  "name": "Publication Facebook auto météo locale + IA pour Hannut",
  "nodes": [
    {
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "name": "Google Sheets - Read Index",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        400,
        300
      ],
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Settings",
          "mode": "name"
        },
        "options": {
          "range": "A1:A1"
        }
      },
      "credentials": {
        "googleApi": {
          "id": "REPLACE_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "Code - Prepare Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const values = items[0].json.values || [];\nconst rawIndex = values[0] && values[0][0] ? values[0][0] : '0';\nconst index = Number(rawIndex) || 0;\nconst row = index + 1;\nreturn [ { json: { index, range: `Images!A${row}` } } ];"
      }
    },
    {
      "name": "Google Sheets - Read Image Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        800,
        300
      ],
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Images",
          "mode": "name"
        },
        "options": {
          "range": "={{$json[\"range\"].split('!')[1]}}"
        }
      },
      "credentials": {
        "googleApi": {
          "id": "REPLACE_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "Code - Pick Image URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const values = items[0].json.values || [];\nconst url = values[0] && values[0][0] ? values[0][0] : null;\nlet index = 0;\ntry {\n  const prep = $('Code - Prepare Range').first().json;\n  if (prep && typeof prep.index !== 'undefined') index = Number(prep.index) || 0;\n} catch (err) {}\nreturn [{ json: { imageUrl: url, index } }];"
      }
    },
    {
      "name": "OpenWeatherMap - Current Weather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.openweathermap.org/data/2.5/weather",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "Hannut,BE"
            },
            {
              "name": "appid",
              "value": "={{$credentials.openWeatherMapApi.apiKey}}"
            },
            {
              "name": "units",
              "value": "metric"
            },
            {
              "name": "lang",
              "value": "fr"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "openWeatherMapApi": {
          "id": "REPLACE_OPENWEATHER_CREDENTIAL_ID",
          "name": "OpenWeatherMap account"
        }
      }
    },
    {
      "name": "IF - Weather Present",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1400,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "weather-present-check",
              "leftValue": "={{$json[\"weather\"] && $json[\"weather\"][0] && $json[\"weather\"][0][\"description\"] ? $json[\"weather\"][0][\"description\"] : \"\"}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Set - Extract Weather",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1600,
        220
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "wd",
              "name": "weatherDescription",
              "value": "={{$json[\"weather\"] && $json[\"weather\"][0] ? $json[\"weather\"][0][\"description\"] : \"temps variable\"}}",
              "type": "string"
            },
            {
              "id": "temp",
              "name": "temperature",
              "value": "={{$json[\"main\"] && $json[\"main\"][\"temp\"] !== undefined ? String($json[\"main\"][\"temp\"]) : \"\"}}",
              "type": "string"
            },
            {
              "id": "raw",
              "name": "weatherRaw",
              "value": "={{JSON.stringify($json)}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Set - Fallback Weather",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1600,
        380
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "wd-fb",
              "name": "weatherDescription",
              "value": "temps variable",
              "type": "string"
            },
            {
              "id": "temp-fb",
              "name": "temperature",
              "value": "",
              "type": "string"
            },
            {
              "id": "raw-fb",
              "name": "weatherRaw",
              "value": "fallback injected because OpenWeatherMap did not return weather[0].description",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Merge - Attach Image to Weather",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1800,
        300
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      }
    },
    {
      "name": "OpenAI",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.8,
      "position": [
        2000,
        300
      ],
      "parameters": {
        "resource": "chat",
        "operation": "create",
        "model": "gpt-3.5-turbo",
        "options": {
          "temperature": 0.7
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu es un rédacteur pour une petite entreprise de nettoyage automobile à Hannut, Belgique. Génère un court titre, un texte convivial et 3 à 6 hashtags pertinents. Le texte doit être local, mentionner la météo si pertinent, et rester simple, utile et professionnel. Ne pas inventer d'informations sur l'image — se baser sur l'URL fournie uniquement pour contexte si nécessaire."
            },
            {
              "role": "user",
              "content": "=Ville: Hannut\nMétéo: {{$json[\"weatherDescription\"]}}\nTempérature (°C): {{$json[\"temperature\"]}}\nImage URL (Imgur): {{$json[\"imageUrl\"]}}\nTâche: Génère (1) un titre court max 6 mots, (2) un texte de post Facebook adapté à un service de lavage/entretien automobile qui parle aux habitants de Hannut et tient compte de la météo fournie, (3) une ligne de hashtags séparés par des espaces. Retourne le tout dans un format clair séparé par trois sections marquées TITLE:, BODY:, HASHTAGS:. Reste en français."
            }
          ]
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "name": "HTTP Request - Facebook Post Photo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{$credentials.facebookGraphApi.pageId}}/photos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{$credentials.facebookGraphApi.pageAccessToken}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{$json[\"imageUrl\"]}}"
            },
            {
              "name": "caption",
              "value": "={{$json[\"choices\"] && $json[\"choices\"][0] && $json[\"choices\"][0][\"message\"] ? $json[\"choices\"][0][\"message\"][\"content\"] : ($json.postText || '')}}"
            },
            {
              "name": "published",
              "value": "true"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "facebookGraphApi": {
          "id": "REPLACE_FACEBOOK_CREDENTIAL_ID",
          "name": "Facebook Graph account"
        }
      }
    },
    {
      "name": "Code - Compute New Index",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "let idx = 0;\ntry {\n  const prep = $('Code - Prepare Range').first().json;\n  if (prep && typeof prep.index !== 'undefined') idx = Number(prep.index) || 0;\n} catch (err) {}\nlet newIndex = idx + 1;\nif (newIndex > 17) newIndex = 0;\nreturn [{ json: { newIndex } }];"
      }
    },
    {
      "name": "Google Sheets - Update Index",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2600,
        300
      ],
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Settings",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "A": "={{$json[\"newIndex\"]}}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "A",
              "displayName": "A",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleApi": {
          "id": "REPLACE_GOOGLE_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "Send Email - Confirmation",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2800,
        300
      ],
      "parameters": {
        "fromEmail": "noreply@example.com",
        "toEmail": "faouzi@example.com",
        "subject": "Publication Facebook envoyée — Hannut",
        "emailFormat": "text",
        "text": "=Bonjour Faouzi,\n\nLe post Facebook a été publié automatiquement ce matin. Voici le texte retourné par l'IA:\n\n{{$('OpenAI').first().json[\"choices\"] && $('OpenAI').first().json[\"choices\"][0] ? $('OpenAI').first().json[\"choices\"][0][\"message\"][\"content\"] : \"(texte non disponible)\"}}\n\nImage: {{$('Code - Pick Image URL').first().json[\"imageUrl\"]}}\n\nSi tu veux arrêter les publications, désactive le workflow.\n\nCordialement,\nTon workflow n8n",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "REPLACE_SMTP_CREDENTIAL_ID",
          "name": "SMTP account"
        }
      }
    },
    {
      "name": "stickyNote - Setup Instructions",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1400,
        100
      ],
      "parameters": {
        "width": 420,
        "height": 520,
        "color": 4,
        "content": "Checklist de configuration (à faire avant activation):\n\n1) Google Sheets\n   - Créer un spreadsheet avec 2 onglets: \"Settings\" et \"Images\".\n   - Dans Settings!A1 stocker l'index courant (0..17).\n   - Dans Images coller jusqu'à 18 URL Imgur en colonne A (A1..A18).\n   - Remplacer REPLACE_WITH_SPREADSHEET_ID dans les 3 noeuds Google Sheets.\n   - Connecter les credentials Google (compte avec accès Sheets).\n\n2) OpenWeatherMap\n   - Obtenir une clé API (compte gratuit). Créer un credential nommé \"OpenWeatherMap account\" (type openWeatherMapApi).\n   - Quota gratuit: 60 appels/minute et 1 000 000 appels/mois — un appel/jour est largement dans les limites.\n\n3) OpenAI\n   - Configurer credential OpenAI dans n8n (clé API). Pas de clé en dur dans le workflow.\n\n4) Facebook\n   - Obtenir un Page Access Token longue durée (manuel, ~60 jours). Créer credential \"Facebook Graph account\" (type facebookGraphApi) contenant pageId et pageAccessToken.\n   - Vérifier via Graph API que POST /{pageId}/photos accepte une URL publique Imgur (JPEG/PNG, <8 Mo, min 200px).\n\n5) Email\n   - Configurer un compte SMTP ou Gmail credential pour l'envoi d'email de confirmation.\n\nNotes techniques:\n - Le noeud IF gère le fallback météo: si weather[0].description absent, la chaîne \"temps variable\" est injectée pour éviter des variables non résolues dans le post.\n - Le workflow n'essaye pas de vérifier la validité de l'URL Imgur au moment de la publication.\n - Surveiller le token Facebook: s'il expire, les publications échoueront.\n - OpenWeatherMap gratuit est suffisant pour un appel par jour."
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Google Sheets - Read Index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Read Index": {
      "main": [
        [
          {
            "node": "Code - Prepare Range",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Prepare Range": {
      "main": [
        [
          {
            "node": "Google Sheets - Read Image Row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Read Image Row": {
      "main": [
        [
          {
            "node": "Code - Pick Image URL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Pick Image URL": {
      "main": [
        [
          {
            "node": "OpenWeatherMap - Current Weather",
            "type": "main",
            "index": 0
          },
          {
            "node": "Merge - Attach Image to Weather",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenWeatherMap - Current Weather": {
      "main": [
        [
          {
            "node": "IF - Weather Present",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Weather Present": {
      "main": [
        [
          {
            "node": "Set - Extract Weather",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Set - Fallback Weather",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set - Extract Weather": {
      "main": [
        [
          {
            "node": "Merge - Attach Image to Weather",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set - Fallback Weather": {
      "main": [
        [
          {
            "node": "Merge - Attach Image to Weather",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge - Attach Image to Weather": {
      "main": [
        [
          {
            "node": "OpenAI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI": {
      "main": [
        [
          {
            "node": "HTTP Request - Facebook Post Photo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request - Facebook Post Photo": {
      "main": [
        [
          {
            "node": "Code - Compute New Index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Compute New Index": {
      "main": [
        [
          {
            "node": "Google Sheets - Update Index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Update Index": {
      "main": [
        [
          {
            "node": "Send Email - Confirmation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "auditNotes": {
      "facebookGraphPhotoUrl": "Le endpoint POST /{page-id}/photos accepte bien un paramètre url pointant vers une URL publique (Imgur inclus) tant que l'image est JPEG/PNG, <8 Mo et >=200px de côté. Facebook télécharge l'image côté serveur; si le format ou la taille ne convient pas, l'API renvoie une erreur 36000/324 et le post échoue silencieusement côté workflow (aucun retry prévu). Recommandation: ajouter un noeud IF sur le code HTTP de réponse et un email d'alerte en cas d'échec.",
      "openWeatherMapQuota": "Le plan gratuit OpenWeatherMap autorise 60 appels/minute et 1 000 000 appels/mois par clé. Un appel unique par jour est très largement dans les limites, aucun risque de rate limit partagé tant que la clé n'est pas utilisée par plusieurs workflows simultanés.",
      "facebookToken": "Le Page Access Token longue durée expire ~60 jours; prévoir un rappel ou un refresh manuel documenté dans le README."
    }
  }
}