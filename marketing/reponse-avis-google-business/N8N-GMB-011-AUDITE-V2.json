{
  "name": "N8N-GMB-011 — Réponses avis Google — AUDITÉ V2",
  "nodes": [
    {
      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "Get Unanswered Reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "https://mybusiness.googleapis.com/v4/accounts/{{$credentials.googleMyBusiness.accountId}}/locations/{{$credentials.googleMyBusiness.locationId}}/reviews",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleMyBusinessOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "orderBy",
              "value": "updateTime desc"
            },
            {
              "name": "pageSize",
              "value": "50"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3",
      "name": "Check New Reviews",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        600,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-reviews-exist",
              "leftValue": "={{ $json['reviews'] && $json['reviews'].length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4",
      "name": "Split Reviews",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        800,
        200
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "5",
      "name": "Normalize Review",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "field-reviewId",
              "name": "reviewId",
              "value": "={{ $json['reviewId'] || $json['name'] || $json['review']?.['reviewId'] || $json['review']?.['name'] || '' }}",
              "type": "string"
            },
            {
              "id": "field-authorName",
              "name": "authorName",
              "value": "={{ $json['reviewer']?.displayName || $json['reviewer']?.name || $json['authorName'] || $json['review']?.['authorName'] || 'Client' }}",
              "type": "string"
            },
            {
              "id": "field-comment",
              "name": "comment",
              "value": "={{ $json['comment'] || $json['review']?.['comment'] || $json['reviewMessage'] || '' }}",
              "type": "string"
            },
            {
              "id": "field-rating",
              "name": "rating",
              "value": "={{ Number($json['starRating'] || $json['rating'] || $json['review']?.['starRating'] || 0) }}",
              "type": "number"
            },
            {
              "id": "field-reviewUrl",
              "name": "reviewUrl",
              "value": "={{ $json['reviewUrl'] || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6",
      "name": "Check Rating",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-rating-gte-4",
              "leftValue": "={{ Number($json['rating']) }}",
              "rightValue": 4,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "7",
      "name": "Generate Response",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.8,
      "position": [
        1400,
        120
      ],
      "parameters": {
        "resource": "chat",
        "operation": "chatCompletion",
        "model": "gpt-3.5-turbo",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Tu es un assistant qui écrit des réponses chaleureuses et professionnelles aux avis Google My Business pour un petit commerce. Adapte le ton selon la note: si la note est >=4, remercie et personnalise brièvement ; si la note est <=3, excuse-toi, propose une solution et invite à contacter le commerce en privé. Ne divulgue pas d'informations sensibles. Reste court (2-4 phrases)."
            },
            {
              "role": "user",
              "content": "=Écris une réponse au commentaire suivant. Note: {{$json['rating']}}. Auteur: {{$json['authorName']}}. Commentaire: \"{{$json['comment']}}\". Si la note est >=4, sois particulièrement enthousiaste et remercie; si <=3, excuse-toi et propose une solution. Inclue le prénom de l'auteur si disponible. Rédige en français."
            }
          ]
        },
        "options": {
          "temperature": 0.7,
          "maxTokens": 250
        }
      }
    },
    {
      "id": "8",
      "name": "Créer brouillon approbation Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1600,
        120
      ],
      "parameters": {
        "resource": "draft",
        "subject": "={{ \"Avis Google à valider — \" + ($json.authorName || \"Client\") + \" — \" + $json.rating + \"/5\" }}",
        "emailType": "text",
        "message": "={{ 'Avis : '+($json.comment||'')+'\\n\\nRéponse IA proposée :\\n'+($('Generate Response').item.json.choices?.[0]?.message?.content || $('Generate Response').item.json.text || '')+'\\n\\nReview ID : '+($json.reviewId||'')+'\\n\\nAprès validation, publier avec Google Business Profile.' }}",
        "options": {
          "sendTo": "={{ $env.OWNER_EMAIL || \"owner@example.com\" }}"
        }
      }
    },
    {
      "id": "9",
      "name": "NOTE — publication manuelle",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1800,
        200
      ],
      "parameters": {
        "content": "## Publication\nV2 prépare un brouillon Gmail pour validation humaine.\nL API Google Business Profile répond à un avis avec PUT /v4/accounts/{accountId}/locations/{locationId}/reviews/{reviewId}/reply.\nLa publication automatique peut être activée dans une personnalisation après validation.",
        "height": 260,
        "width": 430,
        "color": 5
      }
    },
    {
      "id": "10",
      "name": "stickyNote - Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        200,
        50
      ],
      "parameters": {
        "content": "## Audit V2\nExécution quotidienne. L IA prépare une réponse courte et crée un brouillon Gmail pour validation.\nConfigurer Google Business Profile OAuth2 et OWNER_EMAIL.\nAucune réponse publique automatique par défaut.",
        "height": 320,
        "width": 420,
        "color": 4
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get Unanswered Reviews",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Unanswered Reviews": {
      "main": [
        [
          {
            "node": "Check New Reviews",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check New Reviews": {
      "main": [
        [
          {
            "node": "Split Reviews",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Split Reviews": {
      "main": [
        [
          {
            "node": "Normalize Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Review": {
      "main": [
        [
          {
            "node": "Check Rating",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Rating": {
      "main": [
        [
          {
            "node": "Generate Response",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Generate Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Response": {
      "main": [
        [
          {
            "node": "Créer brouillon approbation Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Créer brouillon approbation Gmail": {
      "main": [
        [
          {
            "node": "Split Reviews",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Luxembourg"
  },
  "active": false,
  "versionId": "847fa59b-0fec-4bf9-bab9-16ddd40100dd"
}