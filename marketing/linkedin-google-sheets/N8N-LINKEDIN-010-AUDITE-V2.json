{
  "name": "N8N-LINKEDIN-010 — Publication LinkedIn depuis Sheets — AUDITÉ V2",
  "nodes": [
    {
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "name": "Google Sheets - Read Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        400,
        300
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Planification",
          "mode": "name"
        },
        "options": {
          "returnFirstMatch": true
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "date",
              "lookupValue": "={{ $now.setZone('Europe/Luxembourg').toFormat('yyyy-MM-dd') }}"
            },
            {
              "lookupColumn": "statut",
              "lookupValue": "a publier"
            }
          ]
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "Google Sheets Account",
          "name": "Google Sheets Account"
        }
      }
    },
    {
      "name": "If - Check Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-status",
              "leftValue": "={{ $json[\"statut\"] || $json[\"status\"] || '' }}",
              "rightValue": "a publier",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "LinkedIn - Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.linkedin.com/v2/ugcPosts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "linkedInOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Restli-Protocol-Version",
              "value": "2.0.0"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  author: $json[\"authorUrn\"] || \"urn:li:person:YOUR_PERSON_ID\",\n  lifecycleState: \"PUBLISHED\",\n  specificContent: {\n    \"com.linkedin.ugc.ShareContent\": {\n      shareCommentary: { text: $json[\"texte\"] || $json[\"text\"] || \"\" },\n      shareMediaCategory: \"NONE\"\n    }\n  },\n  visibility: { \"com.linkedin.ugc.MemberNetworkVisibility\": \"PUBLIC\" }\n}) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false,
              "fullResponse": false
            }
          }
        }
      },
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "LinkedIn Personal Account",
          "name": "LinkedIn Personal Account"
        }
      }
    },
    {
      "name": "Google Sheets - Update Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Planification",
          "mode": "name"
        },
        "columns": {
          "matchingColumns": [
            "date"
          ],
          "schema": [
            {
              "id": "date",
              "displayName": "date",
              "required": false,
              "defaultMatch": true,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "statut",
              "displayName": "statut",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false,
          "value": {
            "date": "={{ $('Google Sheets - Read Row').item.json.date }}",
            "statut": "publie"
          }
        },
        "options": {
          "valueInputMode": "USER_ENTERED"
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "Google Sheets Account",
          "name": "Google Sheets Account"
        }
      }
    },
    {
      "name": "DateTime - Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const now = new Date();\nconst iso = now.toISOString();\nconst label = now.toLocaleString('fr-FR', { timeZone: 'UTC' });\nreturn items.map(item => {\n  item.json.publishedAt = iso;\n  item.json.publishedAt_label = label;\n  return item;\n});"
      }
    },
    {
      "name": "Gmail - Send Confirmation",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1400,
        300
      ],
      "parameters": {
        "operation": "send",
        "sendTo": "cm-team@example.com",
        "subject": "=Post LinkedIn publié — {{ $json[\"date\"] || '' }}",
        "message": "=Le post suivant a été publié sur LinkedIn :\n\n{{ $json[\"texte\"] || $json[\"text\"] || '' }}\n\nHorodatage de publication (serveur): {{ $json[\"publishedAt_label\"] }} (ISO: {{ $json[\"publishedAt\"] }})\n\nNote: le workflow publie uniquement du texte brut depuis votre Google Sheets.",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "Google Gmail Account",
          "name": "Google Gmail Account"
        }
      }
    },
