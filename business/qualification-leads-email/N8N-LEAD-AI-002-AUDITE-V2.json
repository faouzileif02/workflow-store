      ],
      "parameters": {
        "resource": "message",
        "operation": "addLabels",
        "messageId": "={{ $json[\"messageId\"] || $json[\"id\"] || $json[\"message-id\"] || '' }}",
        "labelIds": "={{ $json[\"category\"] === 'lead_chaud' ? 'Leads/Lead_Chaude' : ($json[\"category\"] === 'lead_tiede' ? 'Leads/Lead_Tiede' : 'Leads/Spam') }}"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
