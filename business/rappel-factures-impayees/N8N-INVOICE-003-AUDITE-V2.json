    {
      "name": "Format Recap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javascript",
        "jsCode": "const rows = $input.all().map(i => i.json || {}).filter(j => j.email);\nconst uniq = new Map();\nfor (const j of rows) {\n  const key = String(j.email || '') + '|' + String(j.date_echeance || '');\n  if (!uniq.has(key)) uniq.set(key, j);\n}\nconst list = [...uniq.values()];\nconst lines = list.map(j =>\n  `- ${j.client || 'Client'} · ${j.montant || ''} EUR · ${j.email} · retard ${j.daysLate || 0}j`\n);\nreturn [{\n  json: {\n    to: $env.OWNER_EMAIL || 'owner@example.com',\n    subject: `Récapitulatif des relances du ${new Date().toLocaleDateString('fr-LU')}`,\n    text: lines.length ? `Relances envoyées aujourd'hui :\\n${lines.join('\\n')}` : `Aucune relance envoyée aujourd'hui.`\n  }\n}];"
      }
    },
