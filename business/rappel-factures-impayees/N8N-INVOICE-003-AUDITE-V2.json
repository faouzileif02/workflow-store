    {
      "name": "Calculate Delay",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javascript",
        "jsCode": "const items = $input.all();\nconst out = [];\nconst today = new Date();\ntoday.setHours(0,0,0,0);\n\nfor (const item of items) {\n  const json = JSON.parse(JSON.stringify(item.json || {}));\n  const dueRaw = json['date echeance'] || json['date_echeance'] || json['dateEcheance'] || json['Date echeance'] || json['dueDate'] || json['Due Date'] || json['date'];\n  const due = dueRaw ? new Date(dueRaw) : new Date(NaN);\n\n  if (!isNaN(due.getTime())) {\n    due.setHours(0,0,0,0);\n    json.daysLate = Math.floor((today - due) / 86400000);\n  } else {\n    json.daysLate = 0;\n  }\n\n  const lastRaw = json['Derniere Relance'] || json['Dernière Relance'] || json['derniere_relance'] || json['lastReminder'] || '';\n  const last = lastRaw ? new Date(lastRaw) : new Date(NaN);\n  if (!isNaN(last.getTime())) {\n    last.setHours(0,0,0,0);\n    json.daysSinceLastReminder = Math.floor((today - last) / 86400000);\n  } else {\n    json.daysSinceLastReminder = 99999;\n  }\n\n  json.client = json.client || json.Client || json['Nom client'] || '';\n  json.montant = json.montant || json.amount || json.Amount || json.Montant || '';\n  json.email = String(json.email || json.Email || json['Adresse email'] || '').trim();\n  json.statut = json.statut || json.Statut || json.status || json.Status || '';\n  json.date_echeance = dueRaw || json.date_echeance || '';\n  json.lastReminder = lastRaw;\n  json.reminderEligible = json.daysLate > 0 && json.daysSinceLastReminder >= 7 && !!json.email;\n  out.push({ json });\n}\nreturn out;"
      }
    },
    {
      "name": "Filter Overdue",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-statut",
              "leftValue": "={{ $json.statut }}",
              "rightValue": "Payé",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "cond-dayslate",
              "leftValue": "={{ $json.daysLate }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "cond-frequency",
              "leftValue": "={{ $json.reminderEligible }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
