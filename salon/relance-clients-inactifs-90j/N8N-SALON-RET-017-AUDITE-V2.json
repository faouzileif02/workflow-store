    {
      "name": "Code Build Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        420
      ],
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\nconst now = new Date();\nconst week = 7;\nconst recent = [];\nfor (const r of rows) {\n  const dRaw = r.date || r.dateSent || r['Date'];\n  if (!dRaw) continue;\n  const d = new Date(dRaw);\n  if (isNaN(d)) continue;\n  const diffDays = (now - d) / (1000 * 60 * 60 * 24);\n  if (diffDays <= week) {\n    recent.push({ date: r.date, phone: r.phone, firstName: r.firstName });\n  }\n}\nconst body = `Récapitulatif hebdomadaire des relances SMS:\\n\\nNombre de relances (7 derniers jours): ${recent.length}\\n\\nListe :\\n` + recent.map(x => `- ${x.firstName || 'client'} — ${x.phone} — ${x.date}`).join('\\n');\nreturn [{ json: { count: recent.length, list: recent, message: body } }];"
      }
    },
