      ],
      "parameters": {
        "authentication": "oAuth2",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Relances",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "phone",
              "lookupValue": "={{ $json.phone }}"
            }
          ]
        },
        "options": {
          "returnAllMatches": true
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "Code Check Recent Relance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        120
      ],
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\nlet hasRecent = false;\nconst now = new Date();\nfor (const r of rows) {\n  const dRaw = r.date || r.dateSent || r['Date'] || r['date_envoi'];\n  if (!dRaw) continue;\n  const d = new Date(dRaw);\n  if (isNaN(d)) continue;\n  const diffDays = (now - d) / (1000 * 60 * 60 * 24);\n  if (diffDays <= 30) {\n    hasRecent = true;\n    break;\n  }\n}\nconst client = $('IF Check Phone').item.json;\nreturn [{ json: Object.assign({}, client, { hasRecent }) }];"
      }
    },
    {
      "name": "IF No Recent Relance",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1600,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-recent-check",
              "leftValue": "={{ $json.hasRecent }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
