    {
      "name": "Code Filter 90 jours",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        200
      ],
      "parameters": {
        "jsCode": "const days = 90;\nconst threshold = new Date();\nthreshold.setDate(threshold.getDate() - days);\nconst out = [];\nfor (const item of items) {\n  const data = item.json;\n  const lastRaw = data.lastAppointment || data.last_appointment || data['Dernier RDV'] || data['LastAppointment'] || data.lastAppointmentDate;\n  if (!lastRaw) continue;\n  const parsed = new Date(lastRaw);\n  if (isNaN(parsed)) {\n    const parts = String(lastRaw).split(/[\\/\\-\\.]/);\n    if (parts.length === 3) {\n      const d = parseInt(parts[0], 10);\n      const m = parseInt(parts[1], 10) - 1;\n      const y = parseInt(parts[2], 10);\n      const dt = new Date(y, m, d);\n      if (!isNaN(dt) && dt < threshold) out.push({ json: data });\n    }\n    continue;\n  }\n  if (parsed < threshold) out.push({ json: data });\n}\nreturn out;"
      }
    },
    {
      "name": "Loop Over Items — 1 client",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        800,
        200
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "name": "IF Check Phone",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1000,
        120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "phone-check",
              "leftValue": "={{ $json.phone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
