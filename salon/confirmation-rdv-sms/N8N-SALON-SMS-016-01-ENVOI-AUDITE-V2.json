{
  "name": "Salon RDV 01 - Envoi confirmations SMS",
  "nodes": [
    {
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "name": "Google Sheets - GetTomorrow",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        200
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Rendezvous",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "Date",
              "lookupValue": "={{ $now.plus({ days: 1 }).toFormat('yyyy-MM-dd') }}"
            }
          ]
        },
        "options": {
          "returnFirstMatch": false
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "IF - Confirmation empty?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        840,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-confirmation-empty",
              "leftValue": "={{ $json[\"Confirmation\"] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "IF - Phone exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1040,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-phone-exists",
              "leftValue": "={{ $json[\"Phone\"] || $json[\"Telephone\"] || $json[\"PhoneNumber\"] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Google Sheets - Mark NO_PHONE",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1240,
        100
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Rendezvous",
          "mode": "name"
        },
        "columns": {
          "matchingColumns": [
            "ID"
          ],
          "schema": [
            {
              "id": "Confirmation",
              "displayName": "Confirmation",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ],
          "mappingMode": "defineBelow",
          "value": {
            "Confirmation": "NO_PHONE"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "Gmail - Notify no phone",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1440,
        100
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "gerant@example.com",
        "subject": "RDV sans numéro de téléphone — action requise",
        "message": "Le rendez-vous de {{$json[\"Prenom\"] || $json[\"Nom\"]}} le {{$json[\"Date\"]}} à {{$json[\"Heure\"]}} n'a pas de numéro de téléphone renseigné. Merci de vérifier la fiche client et contacter le client si possible.",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "name": "Twilio - Send SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        1240,
        300
      ],
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "from": "+YOUR_TWILIO_NUMBER",
        "to": "={{ $json[\"Phone\"] || $json[\"Telephone\"] || $json[\"PhoneNumber\"] }}",
        "message": "={{ 'Bonjour ' + ($json[\"Prenom\"] || $json[\"Nom\"] || '') + ', vous avez un rendez-vous demain à ' + ($json[\"Heure\"] || '') + ' dans notre salon. Répondez OUI pour confirmer ou NON pour annuler.' }}",
        "options": {}
      },
      "credentials": {
        "twilioApi": {
          "id": "REPLACE_WITH_TWILIO_CREDENTIAL_ID",
          "name": "Twilio account"
        }
      }
    },
    {
      "name": "Google Sheets - Mark SMS_ENVOYE",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Rendezvous",
          "mode": "name"
        },
        "columns": {
          "matchingColumns": [
            "ID"
          ],
          "schema": [
            {
              "id": "Confirmation",
              "displayName": "Confirmation",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "SMS_SentAt",
              "displayName": "SMS_SentAt",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ],
          "mappingMode": "defineBelow",
          "value": {
            "Confirmation": "SMS_ENVOYE",
            "SMS_SentAt": "={{ $now.toFormat('yyyy-MM-dd HH:mm:ss') }}"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "Wait 4 hours",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1640,
        300
      ],
      "parameters": {
        "amount": 4,
        "unit": "hours"
      },
      "webhookId": "wait-4h-confirmation-rdv"
    },
    {
      "name": "Google Sheets - Refresh Row After Wait",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1840,
        300
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Rendezvous",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "ID",
              "lookupValue": "={{ $json[\"ID\"] }}"
            }
          ]
        },
        "options": {
          "returnFirstMatch": true
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "IF - Still SMS_ENVOYE?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2040,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-still-sms-envoye",
              "leftValue": "={{ $json[\"Confirmation\"] }}",
              "rightValue": "SMS_ENVOYE",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Gmail - Notify no response",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        2240,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "gerant@example.com",
        "subject": "Client non répondu au rappel SMS",
        "message": "Le client {{$json[\"Prenom\"] || $json[\"Nom\"]}} pour le rendez-vous de {{$json[\"Date\"]}} à {{$json[\"Heure\"]}} n'a pas confirmé son rendez-vous. La confirmation est restée : {{$json[\"Confirmation\"]}}. Le créneau est potentiellement libre.",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "name": "Sticky Note - Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        420
      ],
      "parameters": {
        "content": "WORKFLOW 1/2 — ENVOI DES CONFIRMATIONS\n\nConfiguration :\n- Google Sheet 'Rendezvous' avec colonnes : ID, Date, Heure, Prenom, Nom, Phone, Confirmation, Client, Booked, SMS_SentAt, ConfirmedAt, CancelledAt\n- Phone au format international E.164, ex. +352621123456\n- Remplacer YOUR_SPREADSHEET_ID\n- Configurer credentials Google Sheets, Gmail et Twilio dans n8n\n- Remplacer +YOUR_TWILIO_NUMBER et gerant@example.com\n\nFonctionnement : tous les jours à 09:00, lit les RDV du lendemain, envoie un SMS, marque SMS_ENVOYE, puis vérifie après 4h si le client a répondu via le workflow 2.",
        "height": 260,
        "width": 420
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Google Sheets - GetTomorrow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - GetTomorrow": {
      "main": [
        [
          {
            "node": "IF - Confirmation empty?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Confirmation empty?": {
      "main": [
        [
          {
            "node": "IF - Phone exists?",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "IF - Phone exists?": {
      "main": [
        [
          {
            "node": "Twilio - Send SMS",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Google Sheets - Mark NO_PHONE",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Mark NO_PHONE": {
      "main": [
        [
          {
            "node": "Gmail - Notify no phone",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Twilio - Send SMS": {
      "main": [
        [
          {
            "node": "Google Sheets - Mark SMS_ENVOYE",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Mark SMS_ENVOYE": {
      "main": [
        [
          {
            "node": "Wait 4 hours",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 4 hours": {
      "main": [
        [
          {
            "node": "Google Sheets - Refresh Row After Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Refresh Row After Wait": {
      "main": [
        [
          {
            "node": "IF - Still SMS_ENVOYE?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Still SMS_ENVOYE?": {
      "main": [
        [
          {
            "node": "Gmail - Notify no response",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}