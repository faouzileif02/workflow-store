    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const src=$('🧹 Normaliser + anti-doublon').all(); const min=Number($('⚙️ Configuration').first().json.minScore||7); const out=[];\nfor(let i=0;i<$input.all().length;i++){\n const raw=String($input.all()[i].json?.choices?.[0]?.message?.content||'').replace(/^```(?:json)?\\s*/i,'').replace(/```\\s*$/,'').trim();\n let ai; try{ai=JSON.parse(raw);}catch(e){continue;} const score=Math.max(0,Math.min(10,Math.round(Number(ai.score||0))));\n if(score<min) continue; out.push({json:{...src[i].json,score,summary:String(ai.summary||'').trim(),reason:String(ai.reason||'').trim()}});\n}\nreturn out.slice(0,10);"
      },
