      "id": "f0216958-ed73-4035-8a2b-c0af3440fa7b",
      "name": "🏛️ BOAMP — Avis récents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -460,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg=$('⚙️ Configuration').first().json;\nconst sent=new Set($('🧠 IDs déjà envoyés').first().json.sentIds||[]);\nconst rows=Array.isArray($json.results)?$json.results:[];\nconst kws=String(cfg.keywords||'').split(',').map(x=>x.trim().toLowerCase()).filter(Boolean);\nconst out=[];\nfor(const r of rows){\n  const id=String(r.idweb||r.id||'').trim(); if(!id||sent.has(id)) continue;\n  const title=String(r.objet||'').trim(); if(!title) continue;\n  const description=String(r.DONNEES||r.criteres||r.descripteur_libelle||'').replace(/<[^>]+>/g,' ').replace(/\\s+/g,' ').trim();\n  const hay=(title+' '+description+' '+String(r.type_marche||'')+' '+String(r.nomacheteur||'')).toLowerCase();\n  const hits=kws.filter(k=>hay.includes(k));\n  if(kws.length && !hits.length) continue;\n  out.push({json:{identifiant_avis:id,titre:title,acheteur:String(r.nomacheteur||''),dateParution:String(r.dateparution||''),dateLimite:String(r.datelimitereponse||''),typeMarche:String(r.type_marche||''),departement:String(r.code_departement_prestation||r.code_departement||''),url:String(r.url_avis||''),description:description.slice(0,500),keywordsMatched:hits}});\n}\nreturn out.slice(0,20);"
      },
      "id": "f621ac28-a75f-4052-b01e-65489ea8ce9e",
      "name": "🧹 Normaliser + anti-doublon",
