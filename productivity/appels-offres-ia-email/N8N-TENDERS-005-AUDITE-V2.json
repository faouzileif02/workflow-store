    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:$('⚙️ Configuration').first().json.model,temperature:0,max_tokens:150,response_format:{type:'json_object'},messages:[{role:'system',content:'Tu qualifies un avis BOAMP pour une TPE. Retourne uniquement un JSON strict {score: entier 0-10, summary: deux phrases maximum, reason: courte}. Ne fabrique rien. Base-toi uniquement sur les données fournies.'},{role:'user',content:JSON.stringify($json)}]}) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "5c5474a7-975e-4d57-ab61-661949988031",
      "name": "🧠 IA — Pertinence appel d’offre",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        20,
        0
      ],
      "credentials": {
        "openRouterApi": {
