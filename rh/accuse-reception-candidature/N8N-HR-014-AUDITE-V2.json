{
  "name": "N8N-HR-014 — Accusé candidature formulaire — AUDITÉ V2",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "candidate-webhook",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "name": "Set Candidate Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        400,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "dateReceived",
              "name": "dateReceived",
              "value": "={{$now.toISO()}}",
              "type": "string"
            },
            {
              "id": "fullName",
              "name": "fullName",
              "value": "={{$json[\"name\"] || $json[\"full_name\"] || $json[\"candidate_name\"] || \"Inconnu\"}}",
              "type": "string"
            },
            {
              "id": "email",
              "name": "email",
              "value": "={{$json[\"email\"] || $json[\"candidate_email\"] || \"\"}}",
              "type": "string"
            },
            {
              "id": "appliedPosition",
              "name": "appliedPosition",
              "value": "={{$json[\"position\"] || $json[\"poste\"] || $json[\"job\"] || \"\"}}",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "={{$json[\"message\"] || $json[\"cover_letter\"] || \"\"}}",
              "type": "string"
            },
            {
              "id": "cvLink",
              "name": "cvLink",
              "value": "={{$json[\"cv_link\"] || $json[\"cvURL\"] || $json[\"resume\"] || \"\"}}",
              "type": "string"
            },
            {
              "id": "status",
              "name": "status",
              "value": "Reçu",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        600,
        300
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Suivi Candidatures",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{$json[\"dateReceived\"]}}",
            "Nom": "={{$json[\"fullName\"]}}",
            "Email": "={{$json[\"email\"]}}",
            "Poste": "={{$json[\"appliedPosition\"]}}",
            "Statut": "={{$json[\"status\"]}}",
            "CV": "={{$json[\"cvLink\"]}}",
            "Message": "={{$json[\"message\"]}}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "Check Email Present",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "email-present",
              "leftValue": "={{$json[\"email\"]}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Gmail to Candidate",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{$json[\"email\"]}}",
        "subject": "=Accusé de réception de votre candidature — {{$json[\"appliedPosition\"] || 'Poste'}}",
        "message": "=Bonjour {{$json[\"fullName\"].split(' ')[0] || 'Candidat(e)'}},<br/><br/>Merci d'avoir postulé pour le poste <strong>{{$json[\"appliedPosition\"] || 'mentionné'}}</strong>.<br/>Nous avons bien reçu votre candidature le {{$json[\"dateReceived\"]}} et notre équipe la traite. Nous reviendrons vers vous si votre profil correspond à nos besoins.<br/><br/>Si vous souhaitez nous envoyer d'autres informations, répondez simplement à cet email.<br/><br/>Cordialement,<br/>L'équipe de recrutement",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "name": "Gmail to Recruiter",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1000,
        400
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "REPLACE_WITH_RECRUITER_EMAIL",
        "subject": "=Nouvelle candidature reçue — {{$json[\"appliedPosition\"] || 'Poste'}} — {{$json[\"fullName\"]}}",
        "message": "=Nouvelle candidature reçue :<br/><br/><strong>Nom :</strong> {{$json[\"fullName\"]}}<br/><strong>Email :</strong> {{$json[\"email\"] || '(non fourni)'}}<br/><strong>Poste :</strong> {{$json[\"appliedPosition\"]}}<br/><strong>Date :</strong> {{$json[\"dateReceived\"]}}<br/><strong>CV :</strong> {{$json[\"cvLink\"] || '(aucun lien)'}}<br/><br/><strong>Message candidat :</strong><br/>{{$json[\"message\"] || '(aucun message)'}}<br/><br/>Statut enregistré dans Google Sheets : <strong>{{$json[\"status\"]}}</strong>",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {status:\"success\", message:\"Candidature reçue\"} }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "name": "Setup Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        400,
        100
      ],
      "parameters": {
        "content": "## N8N-HR-014 — Audit V2\nLe webhook répond immédiatement 200 avant les opérations Google/Gmail pour éviter le timeout du formulaire.\n\nGoogle Sheets recommandé :\nTimestamp | Nom | Email | Téléphone | Poste | Message | CV_URL | Statut\n\nLe workflow stocke seulement un lien CV. Si le fichier est privé, utilisez une URL accessible au recruteur ou ajoutez une étape Google Drive dédiée.",
        "height": 320,
        "width": 480,
        "color": 4
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Candidate Data": {
      "main": [
        [
          {
            "node": "Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets": {
      "main": [
        [
          {
            "node": "Check Email Present",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Email Present": {
      "main": [
        [
          {
            "node": "Gmail to Candidate",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Gmail to Recruiter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail to Candidate": {
      "main": [
        [
          {
            "node": "Gmail to Recruiter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail to Recruiter": {
      "main": []
    },
    "Respond to Webhook": {
      "main": [
        [
          {
            "node": "Set Candidate Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "93c7b26f-3aae-46df-ba53-da68e4828039"
}