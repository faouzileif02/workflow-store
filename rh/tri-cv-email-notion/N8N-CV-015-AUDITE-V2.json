{
  "name": "N8N-CV-015 — Tri CV email vers Notion — AUDITÉ V2",
  "nodes": [
    {
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 2,
      "position": [
        200,
        200
      ],
      "parameters": {
        "labelIds": [
          "INBOX"
        ],
        "includeAttachments": true,
        "options": {
          "checkInterval": 900
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-credentials",
          "name": "Gmail account"
        }
      }
    },
    {
      "name": "Filter - CV or Attachment",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        400,
        200
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"textPlain\"] || $json[\"snippet\"] || $json[\"body\"] || ''}}",
              "operation": "contains",
              "value2": "CV"
            },
            {
              "value1": "={{$json[\"textPlain\"] || $json[\"snippet\"] || $json[\"body\"] || ''}}",
              "operation": "contains",
              "value2": "candidature"
            },
            {
              "value1": "={{$json[\"textPlain\"] || $json[\"snippet\"] || $json[\"body\"] || ''}}",
              "operation": "contains",
              "value2": "poste"
            }
          ],
          "boolean": [],
          "number": [],
          "date": []
        },
        "combineOperation": "any",
        "additionalFields": {
          "mode": "any",
          "rules": [
            {
              "name": "Has PDF attachment",
              "value1": "={{($binary && Object.keys($binary).length > 0) ? $binary : ''}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      }
    },
    {
      "name": "Extract From File (PDF -> text)",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        600,
        200
      ],
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "attachment_0",
        "options": {}
      }
    },
    {
      "name": "Information Extractor (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        200
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "url": "https://api.openai.com/v1/chat/completions",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:'gpt-4o-mini',temperature:0,max_tokens:500,response_format:{type:'json_object'},messages:[{role:'system',content:'Extract candidate data. Return strict JSON only with keys name, email, phone, position, years_experience. Unknown fields must be empty strings.'},{role:'user',content:'Extract data from this CV:\\n\\n'+String($json.text || $json.extractedText || '').slice(0,16000)}]}) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "openai-credentials",
          "name": "OpenAI account"
        }
      }
    },
    {
      "name": "Parse Extracted Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item=>{const r=item.json||{}; const raw=String(r.choices?.[0]?.message?.content||'').trim().replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,''); let p; try{p=JSON.parse(raw)}catch(e){throw new Error('Réponse IA CV invalide: '+raw.slice(0,300))} return {json:{...r,name:String(p.name||''),email:String(p.email||''),phone:String(p.phone||''),position:String(p.position||''),years_experience:p.years_experience??''}};});"
      }
    },
    {
      "name": "Switch by Position",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1200,
        200
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{$json[\"position\"]}}",
                    "rightValue": "dev",
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "dev"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{$json[\"position\"]}}",
                    "rightValue": "engineer",
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "engineer"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "name": "Notion - Create Page",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        1400,
        120
      ],
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": {
          "__rl": true,
          "value": "REPLACE_WITH_NOTION_DATABASE_ID",
          "mode": "id"
        },
        "title": "={{$json.name || 'Candidat sans nom'}}",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Email|email",
              "emailValue": "={{$json.email || ''}}"
            },
            {
              "key": "Phone|phone_number",
              "phoneValue": "={{$json.phone || ''}}"
            },
            {
              "key": "Position|rich_text",
              "textValue": "={{$json.position || ''}}"
            },
            {
              "key": "YearsExperience|number",
              "numberValue": "={{$json.years_experience ? Number($json.years_experience) : 0}}"
            },
            {
              "key": "Status|select",
              "selectValue": "A évaluer"
            }
          ]
        }
      },
      "credentials": {
        "notionApi": {
          "id": "notion-credentials",
          "name": "Notion account"
        }
      }
    },
    {
      "name": "Gmail - Send Confirmation",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1400,
        280
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{$json.email}}",
        "subject": "Réception de votre candidature",
        "message": "Bonjour {{$json.name || 'candidat'}},\n\nNous avons bien reçu votre candidature pour le poste \"{{$json.position || ''}}\". Notre équipe RH va l'examiner et nous vous recontacterons si votre profil correspond.\n\nCordialement,\nL'équipe recrutement",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-credentials",
          "name": "Gmail account"
        }
      }
    },
    {
      "name": "Slack - Notify Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1600,
        200
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#recrutement",
          "mode": "name"
        },
        "text": "Nouvelle candidature reçue : *{{$json.name || 'N/A'}}*\nPoste : {{$json.position || 'N/A'}}\nEmail : {{$json.email || 'N/A'}}\n(Consulter la fiche Notion pour plus de détails)",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": {
          "id": "slack-credentials",
          "name": "Slack account"
        }
      }
    },
    {
      "name": "Setup - Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        200,
        440
      ],
      "parameters": {
        "content": "## Audit V2\nBase Notion : Name(title) | Email(email) | Phone(phone_number) | Position(rich_text) | YearsExperience(number) | Status(select).\nLe PDF original est archivé dans Drive. Configurer REPLACE_WITH_CV_ARCHIVE_FOLDER_ID. Les PDF scannés nécessitent OCR.",
        "height": 320,
        "width": 400
      }
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "inputDataFieldName": "attachment_0",
        "name": "={{ ($json.subject || 'CV') + '-' + $now.toFormat('yyyyMMdd-HHmmss') + '.pdf' }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_CV_ARCHIVE_FOLDER_ID"
        },
        "options": {}
      },
      "id": "4cc923fa-524e-480b-b26e-277f0a3dffb8",
      "name": "Google Drive — Archiver PDF original",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        500,
        480
      ]
    }
  ],
