{
  "name": "N8N-AMAZON-013 — Alerte prix Amazon API — AUDITÉ V2",
  "nodes": [
    {
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      }
    },
    {
      "name": "Google Sheets - Read",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        400,
        300
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "options": {
          "returnAll": true
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "SplitInBatches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        600,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "name": "Rainforest API — Product",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "url": "https://api.rainforestapi.com/request",
        "method": "GET",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "api_key",
              "value": "={{ $env.RAINFOREST_API_KEY }}"
            },
            {
              "name": "type",
              "value": "product"
            },
            {
              "name": "amazon_domain",
              "value": "={{ $json.amazon_domain || \"amazon.de\" }}"
            },
            {
              "name": "asin",
              "value": "={{ $json.asin }}"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false,
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "name": "Préparer ASIN",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j=$json||{}; const url=String(j.url||''); const m=url.match(/\\/(?:dp|gp\\/product)\\/([A-Z0-9]{10})(?:[/?]|$)/i)||url.match(/([A-Z0-9]{10})/i); const asin=String(j.asin||j.ASIN||(m?m[1]:'')).toUpperCase(); if(!asin) throw new Error('ASIN introuvable pour '+url); let domain='amazon.de'; try{domain=new URL(url).hostname.replace(/^www\\./,'')}catch(e){} return {json:{...j,asin,amazon_domain:domain}};"
      }
    },
    {
      "name": "Code - Parse Price",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j=$json||{}; const p=j.product||{}; const raw=p.buybox_winner?.price?.value??p.buybox_winner?.price?.raw??p.price?.value??null; const cur=typeof raw==='number'?raw:parseFloat(String(raw||'').replace(/[^0-9,.]/g,'').replace(',','.')); if(!Number.isFinite(cur)) throw new Error('Prix Amazon non disponible.'); const s=$('Préparer ASIN').item.json; const target=parseFloat(String(s.targetPrice??s.TargetPrice??s.target_price??s.target??'').replace(',','.')); if(!Number.isFinite(target)) throw new Error('Prix cible invalide.'); return {json:{name:s.name||s.productName||s.title||p.title||s.asin,url:s.url||p.link||'',asin:s.asin,currentPrice:cur,targetPrice:target,notify:cur<=target,rowIndex:s.rowIndex??s.rowNumber??s.row_number??null}};"
      }
    },
    {
      "name": "If - Price <= Target",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1400,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-notify",
              "leftValue": "={{ $json.notify }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Google Sheets - Update (Notify)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        1600,
        200
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $json.rowIndex }}",
            "lastChecked": "={{ new Date().toISOString() }}",
            "lastObservedPrice": "={{ $json.currentPrice }}"
          },
          "matchingColumns": [
            "row_number"
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "Google Sheets - Update (No Notify)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        1600,
        400
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $json.rowIndex }}",
            "lastChecked": "={{ new Date().toISOString() }}",
            "lastObservedPrice": "={{ $json.currentPrice }}"
          },
          "matchingColumns": [
            "row_number"
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "name": "Gmail - Send",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1800,
        200
      ],
      "parameters": {
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "={{ `Alerte prix: ${$json.name} — ${$json.currentPrice}` }}",
        "message": "={{ `Produit: ${$json.name}\\nPrix actuel: ${$json.currentPrice}\\nPrix cible: ${$json.targetPrice}\\nLien: ${$json.url}` }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        2000,
        300
      ],
      "parameters": {
        "content": "## Audit V2\nLe scraping HTML Amazon a été retiré. V2 utilise Rainforest API. Définir RAINFOREST_API_KEY.\nSheet : name | url | asin(optionnel) | targetPrice | lastChecked | lastObservedPrice | row_number.\nL’ASIN est extrait de l’URL si absent.",
        "height": 400,
        "width": 500
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Google Sheets - Read",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Read": {
      "main": [
        [
          {
            "node": "SplitInBatches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SplitInBatches": {
      "main": [
        [
          {
            "node": "Préparer ASIN",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Parse Price": {
      "main": [
        [
          {
            "node": "If - Price <= Target",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If - Price <= Target": {
      "main": [
        [
          {
            "node": "Google Sheets - Update (Notify)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Google Sheets - Update (No Notify)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Update (Notify)": {
      "main": [
        [
          {
            "node": "Gmail - Send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gmail - Send": {
      "main": [
        [
          {
            "node": "SplitInBatches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets - Update (No Notify)": {
      "main": [
        [
          {
            "node": "SplitInBatches",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sticky Note": {
      "main": []
    },
    "Préparer ASIN": {
      "main": [
        [
          {
            "node": "Rainforest API — Product",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rainforest API — Product": {
      "main": [
        [
          {
            "node": "Code - Parse Price",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "versionId": "dcf482ce-4311-4982-8b36-1bf8b381bf81"
}